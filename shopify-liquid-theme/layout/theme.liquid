<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    <script>
      // Read by src/lib/siteConfig.js. siteUrl points at the Netlify site that
      // hosts the free-guide PDF, guide images and the Slack lead relay.
      window.MOTIONPLUSE_CONFIG = {
        siteUrl: {{ settings.netlify_site_url | default: '' | json }},
        guidePdfUrl: {{ settings.guide_pdf_url | default: '' | json }}
      };
    </script>
    <script type="module" crossorigin src="{{ 'index.js' | asset_url }}"></script>
    <link rel="stylesheet" crossorigin href="{{ 'index.css' | asset_url }}">
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <div id="root"></div>
    <main role="main" id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
